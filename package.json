{
  "name": "@craftlions/pdfium-rs",
  "version": "0.0.15",
  "repository": {
    "type": "git",
    "url": "https://github.com/craftlions/rs"
  },
  "type": "module",
  "description": "My napi-rs addon",
  "main": "index.js",
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "napi": {
    "binaryName": "pdfium",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "node test.js",
    "typecheck": "tsc --noEmit -p .",
    "changeset:patch": "changeset add --patch @craftlions/pdfium-rs",
    "changeset:minor": "changeset add --minor @craftlions/pdfium-rs",
    "changeset:major": "changeset add --major @craftlions/pdfium-rs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "npm",
    "README.md",
    "LICENSE*"
  ],
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@napi-rs/cli": "3.10.12",
    "@types/node": "26.6.6",
    "typescript": "7.1.0-beta"
  },
  "packageManager": "aube@2.10.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    }
  }
}
